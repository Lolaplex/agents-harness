{
  "name": "mcp.docs.write",
  "kind": "mcp",
  "when": "on_request",
  "cadence": "on_request",
  "verb": "python -m agents_docs write",
  "rests_on": "agents-docs CLI append a hard tech fact; positionals name content [category]; exit 0 = wrote",
  "expected_exit": 0,
  "timeout_sec": 30,
  "as_tool": true,
  "parameters": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Document stem (e.g. coolify-db-ports)"
      },
      "content": {
        "type": "string",
        "description": "Markdown fact to append"
      },
      "category": {
        "type": "string",
        "description": "stacks, models, apis, platforms, or custom"
      }
    },
    "required": ["name", "content"]
  }
}
